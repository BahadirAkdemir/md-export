{
  "name": "md-export",
  "displayName": "Markdown Export",
  "description": "Convert Markdown to PDF, HTML, DOCX, RTF, EPUB, XML (DocBook), and PNG. No system pandoc/wkhtmltopdf required.",
  "version": "0.0.1",
  "publisher": "bahadirakdemir",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bahadirakdemir/md-export.git"
  },
  "bugs": {
    "url": "https://github.com/bahadirakdemir/md-export/issues"
  },
  "homepage": "https://github.com/bahadirakdemir/md-export#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other", "Formatters"],
  "keywords": ["markdown", "pdf", "html", "docx", "epub", "rtf", "export", "convert"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      { "command": "mdExport.exportPdf",   "title": "Export as PDF",       "category": "Markdown Export" },
      { "command": "mdExport.exportHtml",  "title": "Export as HTML",      "category": "Markdown Export" },
      { "command": "mdExport.exportDocx",  "title": "Export as DOCX",      "category": "Markdown Export" },
      { "command": "mdExport.exportRtf",   "title": "Export as RTF",       "category": "Markdown Export" },
      { "command": "mdExport.exportEpub",  "title": "Export as EPUB",      "category": "Markdown Export" },
      { "command": "mdExport.exportXml",   "title": "Export as XML (DocBook)", "category": "Markdown Export" },
      { "command": "mdExport.exportPng",   "title": "Export as PNG",       "category": "Markdown Export" }
    ],
    "submenus": [
      { "id": "mdExport.submenu", "label": "Export Markdown" }
    ],
    "menus": {
      "editor/context": [
        { "submenu": "mdExport.submenu", "when": "resourceLangId == markdown", "group": "mdExport@1" }
      ],
      "explorer/context": [
        { "submenu": "mdExport.submenu", "when": "resourceExtname == .md || explorerResourceIsFolder", "group": "mdExport@1" }
      ],
      "mdExport.submenu": [
        { "command": "mdExport.exportPdf",   "group": "format@1" },
        { "command": "mdExport.exportHtml",  "group": "format@2" },
        { "command": "mdExport.exportDocx",  "group": "format@3" },
        { "command": "mdExport.exportRtf",   "group": "format@4" },
        { "command": "mdExport.exportEpub",  "group": "format@5" },
        { "command": "mdExport.exportXml",   "group": "format@6" },
        { "command": "mdExport.exportPng",   "group": "format@7" }
      ]
    },
    "configuration": {
      "title": "Markdown Export",
      "properties": {
        "mdExport.theme": {
          "type": "string",
          "enum": ["github", "academic", "minimal", "dark"],
          "default": "github",
          "description": "Built-in CSS theme used when no customCssPath is set."
        },
        "mdExport.customCssPath": {
          "type": "string",
          "default": "",
          "description": "Absolute or workspace-relative path to a custom CSS file applied on top of the chosen theme."
        },
        "mdExport.defaultExportFormat": {
          "type": "string",
          "enum": ["pdf", "html", "docx", "rtf", "epub", "xml", "png"],
          "default": "pdf",
          "description": "Format used by the status-bar one-click export."
        },
        "mdExport.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Where exported files are written. Empty = beside the source file."
        },
        "mdExport.fileNameTemplate": {
          "type": "string",
          "default": "${basename}.${ext}",
          "description": "Output file name template. Available vars: ${basename}, ${ext}, ${date}."
        },
        "mdExport.openAfterExport": {
          "type": "boolean",
          "default": true,
          "description": "Open the exported file in the OS default application after a successful export."
        },
        "mdExport.pdf.format": {
          "type": "string",
          "enum": ["A4", "Letter", "Legal", "A3", "A5"],
          "default": "A4",
          "description": "PDF page size."
        },
        "mdExport.pdf.margin": {
          "type": "object",
          "default": { "top": "20mm", "right": "20mm", "bottom": "20mm", "left": "20mm" },
          "description": "PDF page margins (CSS length strings)."
        },
        "mdExport.pdf.printBackground": {
          "type": "boolean",
          "default": true,
          "description": "Print CSS backgrounds in PDF output."
        },
        "mdExport.pdf.headerTemplate": {
          "type": "string",
          "default": "",
          "description": "Puppeteer header HTML template. See https://pptr.dev/api/puppeteer.pdfoptions"
        },
        "mdExport.pdf.footerTemplate": {
          "type": "string",
          "default": "<div style=\"font-size:9px;width:100%;text-align:center;color:#888\"><span class=\"pageNumber\"></span> / <span class=\"totalPages\"></span></div>",
          "description": "Puppeteer footer HTML template."
        },
        "mdExport.png.deviceScaleFactor": {
          "type": "number",
          "default": 2,
          "description": "Device pixel ratio for PNG rendering."
        },
        "mdExport.png.width": {
          "type": "number",
          "default": 1024,
          "description": "Viewport width in CSS pixels for PNG rendering."
        },
        "mdExport.toc.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Auto-generate a table of contents at the top of the document."
        },
        "mdExport.toc.depth": {
          "type": "number",
          "default": 3,
          "description": "Maximum heading depth to include in the TOC."
        },
        "mdExport.shiki.theme": {
          "type": "string",
          "default": "github-light",
          "description": "Shiki theme name for syntax-highlighted code blocks."
        },
        "mdExport.mermaid.theme": {
          "type": "string",
          "enum": ["default", "dark", "forest", "neutral"],
          "default": "default",
          "description": "Mermaid diagram theme."
        },
        "mdExport.chromium.buildId": {
          "type": "string",
          "default": "",
          "description": "Override pinned Chromium build ID used by @puppeteer/browsers."
        },
        "mdExport.chromium.idleTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Close the headless browser after this many milliseconds of inactivity."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "compile-tests": "tsc -p ./tsconfig.json --noEmit",
    "package": "vsce package",
    "test": "vitest run",
    "test:integration": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@jsdevtools/rehype-toc": "^3.0.2",
    "@lesjoursfr/html-to-epub": "^4.0.0",
    "@puppeteer/browsers": "^2.2.0",
    "@shikijs/rehype": "^1.3.0",
    "html-to-docx": "^1.8.0",
    "jszip": "^3.10.1",
    "juice": "^11.0.0",
    "katex": "^0.16.10",
    "puppeteer-core": "^23.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-document": "^7.0.3",
    "rehype-katex": "^7.0.0",
    "rehype-mermaid": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "unified": "^11.0.4",
    "unist-util-visit": "^5.0.0",
    "xmlbuilder2": "^3.1.1",
    "yaml": "^2.4.0",
    "zod": "^3.22.4"
  }
}
